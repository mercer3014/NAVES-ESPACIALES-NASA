# Runtime image for the sanitized transfer bundle.
# Context must contain package.json, package-lock.json, server/, and dist-expeditions/.
# node:22-bookworm-slim is multi-arch, including linux/arm64. Build on the ARM64 host:
#   docker build -t planta-la-bandera:local .
# EXPOSE does not publish a host port. No secrets are copied. npm ci installs production dependencies only.
FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787 \
    STATIC_DIR=dist-expeditions
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force && rm -rf /root/.npm && chown -R node:node /app
COPY --chown=node:node dist-expeditions ./dist-expeditions
COPY --chown=node:node server ./server
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.js"]
